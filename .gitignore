!/GRAVV-KIT-OFICIAL/01-IDENTIDADE/01-LOGO/GRAVV-WORDMARK-WHITE.png

# Não versionar credenciais nem arquivos temporários, mesmo em pastas liberadas.
**/.env
**/.env.*
**/*.pem
**/*.key
**/node_modules/
**/__pycache__/
**/*.log
**/.DS_Store
**/Thumbs.db
