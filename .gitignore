!/README.md
!/index.html
!/assets/
/assets/*
!/assets/hero-journey.css
!/assets/hero-journey.js
!/docs/
/docs/*
!/docs/HERO-01-ANIMACAO-E-LINGUAGEM.md
!/GRAVV-KIT-OFICIAL/
/GRAVV-KIT-OFICIAL/*
!/GRAVV-KIT-OFICIAL/01-IDENTIDADE/
